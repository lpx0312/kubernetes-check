gofunc CollectAllNodeMetrics() []NodePressure {    // 步骤1：获取所有节点列表    nodes, _ := k8sClient.CoreV1().Nodes().List(context.TODO(), metav1.ListOptions{})        var results []NodePressure        for _, node := range nodes.Items {        pressure := NodePressure{NodeName: node.Name}                // 步骤2：获取基础压力状态        for _, cond := range node.Status.Conditions {            // ...同前面代码...        }                // 步骤3：获取详细指标        if metrics, err := GetNodeMetrics(node.Name); err == nil {            pressure.MemUsage = float64(metrics.Memory) / 1e9 // 转换为GB        }                // 步骤4：通过SSH获取特殊指标        if nodeIP := getNodeInternalIP(node); nodeIP != "" {            if pidCount, pidMax, err := GetNodePidUsage(nodeIP); err == nil {                pressure.PIDUsage = float64(pidCount)/float64(pidMax)*100            }        }                results = append(results, pressure)    }    return results}
关键注意事项

网络连通性：确保Master可以访问各节点的kubelet端口（默认10250）和SSH端口
性能优化：go// 使用缓存减少API调用var nodeMetricsCache map[string]cachedMetric func GetCachedMetrics(nodeName string) (NodeMetrics, error) {    if cache, ok := nodeMetricsCache[nodeName]; ok && time.Since(cache.Timestamp) < 5*time.Minute {        return cache.Data, nil    }    // ...重新获取数据...}
错误处理：

处理部分节点不可达的情况
设置SSH连接超时（建议5秒）
指标采集失败时保留旧数据并标记状态
